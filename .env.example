# Source catalog origin (host). Used as the base for page/search requests.
SOURCE_ORIGIN=

# Path of the token endpoint under SOURCE_ORIGIN (origin + path => token API).
TOKEN_PATH=/api/create_session.php

# Video player origin (host). Used to normalize the playback host at runtime.
PLAYER_ORIGIN=

# Secret for the opaque playKey/detailKey encryption (AES-256-GCM). Set a long random value.
PLAYER_TOKEN_SECRET=

# Stable HMAC secret for contentId. Do not rotate it after launch.
# Falls back to PLAYER_TOKEN_SECRET when omitted.
CONTENT_ID_SECRET=

# Secret used to sign the short-lived HttpOnly cookie required by /api routes.
# Set a separate long random value in production. Falls back to PLAYER_TOKEN_SECRET.
API_ACCESS_SECRET=

# Optional comma-separated origins allowed by /api/img.
# When empty, public HTTP(S) image hosts are allowed and private/local hosts are blocked.
IMAGE_ALLOWED_ORIGINS=

# Image delivery: "true" (default) serves images via /api/img so the source host
# is hidden (costs server bandwidth). Set to "false" to load images directly.
IMG_PROXY=true

# Search endpoint path under SOURCE_ORIGIN (kept here so the source route is not in code).
SEARCH_PATH=/bbs/ajax.searchList.php

# MongoDB Atlas connection used only by server-side first-party analytics.
MONGODB=
MONGODB_DB=watching_analytics

# Enable analytics explicitly and use a dedicated random HMAC secret.
ANALYTICS_ENABLED=false
ANALYTICS_HASH_SECRET=
