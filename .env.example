# Source catalog origin (host). Used as the base for page/search requests.
SOURCE_ORIGIN=

# Path of the token endpoint under SOURCE_ORIGIN (origin + path => token API).
TOKEN_PATH=/api/create_session.php

# Video player origin (host). Used to normalize the playback host at runtime.
PLAYER_ORIGIN=

# Secret for the opaque playKey/detailKey encryption (AES-256-GCM). Set a long random value.
PLAYER_TOKEN_SECRET=

# Image delivery: "true" (default) serves images via /api/img so the source host
# is hidden (costs server bandwidth). Set to "false" to load images directly.
IMG_PROXY=true

# Search endpoint path under SOURCE_ORIGIN (kept here so the source route is not in code).
SEARCH_PATH=/bbs/ajax.searchList.php
